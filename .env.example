# =============================================================================
# Phoenix Portal — environment variables
# =============================================================================
# VITE_* variables are embedded in the browser bundle at build time.
# Server-only secrets belong in Supabase Dashboard → Edge Functions → Secrets
# (and in your local `.env` for `supabase functions serve`, never committed).
# =============================================================================

# --- Supabase (client / Vite) ---
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE

# --- Strava (optional, client id only in bundle) ---
VITE_STRAVA_CLIENT_ID=your-strava-client-id

# --- Sentry (optional) ---
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Paddle (client) ---
# https://vendors.paddle.com/authentication
VITE_PADDLE_CLIENT_TOKEN=
# "sandbox" for test mode, omit or empty for production
VITE_PADDLE_ENVIRONMENT=
# Catalog → Prices — one ID per tier per billing interval (used by checkout UI)
VITE_PADDLE_EMBER_MONTHLY_PRICE_ID=
VITE_PADDLE_EMBER_ANNUAL_PRICE_ID=
VITE_PADDLE_FLAME_MONTHLY_PRICE_ID=
VITE_PADDLE_FLAME_ANNUAL_PRICE_ID=
VITE_PADDLE_INFERNO_MONTHLY_PRICE_ID=
VITE_PADDLE_INFERNO_ANNUAL_PRICE_ID=

# --- Supabase Edge Functions (set as secrets, NOT VITE_) ---
# Core
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# APP_URL=
# ENVIRONMENT=development|staging|production

# Paddle (server — tier mapping uses comma-separated lists, monthly + annual IDs)
# PADDLE_EMBER_PRICE_IDS=pri_xxx,pri_yyy
# PADDLE_FLAME_PRICE_IDS=
# PADDLE_INFERNO_PRICE_IDS=
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# HMAC for checkout custom_data (must match Edge secret; see paddle-checkout-custom-data)
# PADDLE_CUSTOM_DATA_SECRET=
# PADDLE_ENVIRONMENT=sandbox

# OAuth provider secrets (callbacks + sync)
# STRAVA_CLIENT_ID= / STRAVA_CLIENT_SECRET=
# FITBIT_CLIENT_ID= / FITBIT_CLIENT_SECRET=
# GARMIN_CONSUMER_KEY= / GARMIN_CONSUMER_SECRET=

# Queue + integrations
# PROCESS_SYNC_QUEUE_SECRET=
# GARMIN_WEBHOOK_SECRET=

# Token encryption at rest (oauth_tokens) — generate a 32-byte key, base64-encode
# OAUTH_TOKEN_ENCRYPTION_KEY=

# Supabase type generation: npx supabase login && npm run gen:types
