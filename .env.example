# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_UDrjasV6UJLm_IdIzGljoQ_YaRes4dQ

# Strava Integration (Optional)
# Get these from: https://www.strava.com/settings/api
VITE_STRAVA_CLIENT_ID=your-strava-client-id

# Sentry Error Monitoring (Optional)
# Get DSN from: Sentry Dashboard -> Settings -> Projects -> Client Keys (DSN)
VITE_SENTRY_DSN=
# Get auth token from: Sentry Dashboard -> Settings -> Auth Tokens
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Paddle Billing
# Get client token from: https://vendors.paddle.com/authentication
VITE_PADDLE_CLIENT_TOKEN=
# Set to "sandbox" for test mode, omit or leave empty for live/production
VITE_PADDLE_ENVIRONMENT=
# Price IDs from Paddle Dashboard > Catalog > Prices
VITE_PADDLE_EMBER_MONTHLY_PRICE_ID=
VITE_PADDLE_EMBER_ANNUAL_PRICE_ID=
VITE_PADDLE_FLAME_MONTHLY_PRICE_ID=
VITE_PADDLE_FLAME_ANNUAL_PRICE_ID=
VITE_PADDLE_INFERNO_MONTHLY_PRICE_ID=
VITE_PADDLE_INFERNO_ANNUAL_PRICE_ID=

# Supabase Type Generation
# Project ref is hardcoded in package.json gen:types script.
# To generate types: 1) npx supabase login  2) npm run gen:types
# SUPABASE_PROJECT_REF=ilzlswmatadlnsuxatcv
