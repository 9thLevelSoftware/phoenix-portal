# =============================================================================
# Phoenix Portal — environment variables
# =============================================================================
# VITE_* variables are embedded in the browser bundle at build time.
# Server-only secrets belong in Supabase Dashboard → Edge Functions → Secrets
# (and in your local `.env` for `supabase functions serve`, never committed).
# =============================================================================

# --- Supabase (client / Vite) ---
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE

# --- Social auth provisioning (used by `npm run auth:social:push`) ---
# Requires `npx supabase login` in the same shell profile. The project ref is
# inferred from `VITE_SUPABASE_URL`, but you can override it explicitly.
SUPABASE_PROJECT_REF=
SUPABASE_AUTH_SITE_URL=https://your-portal-domain.com
# Optional comma-separated exact redirect URLs in addition to localhost and
# `${SUPABASE_AUTH_SITE_URL}/auth/callback`
SUPABASE_AUTH_ADDITIONAL_REDIRECT_URLS=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- Strava (optional, client id only in bundle) ---
VITE_STRAVA_CLIENT_ID=your-strava-client-id

# --- Sentry (optional) ---
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Paddle (client) ---
# https://vendors.paddle.com/authentication
VITE_PADDLE_CLIENT_TOKEN=
# "sandbox" for test mode, omit or empty for production
VITE_PADDLE_ENVIRONMENT=
# Catalog → Prices — one ID per tier per billing interval (used by checkout UI)
VITE_PADDLE_EMBER_MONTHLY_PRICE_ID=
VITE_PADDLE_EMBER_ANNUAL_PRICE_ID=
VITE_PADDLE_FLAME_MONTHLY_PRICE_ID=
VITE_PADDLE_FLAME_ANNUAL_PRICE_ID=
VITE_PADDLE_INFERNO_MONTHLY_PRICE_ID=
VITE_PADDLE_INFERNO_ANNUAL_PRICE_ID=

# --- Supabase Edge Functions (set as secrets, NOT VITE_) ---
# Core
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# APP_URL=
# ENVIRONMENT=development|staging|production

# Paddle (server — tier mapping uses comma-separated lists, monthly + annual IDs)
# PADDLE_EMBER_PRICE_IDS=pri_xxx,pri_yyy
# PADDLE_FLAME_PRICE_IDS=
# PADDLE_INFERNO_PRICE_IDS=
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# HMAC for checkout custom_data (must match Edge secret; see paddle-checkout-custom-data)
# PADDLE_CUSTOM_DATA_SECRET=
# PADDLE_ENVIRONMENT=sandbox

# OAuth provider secrets (callbacks + sync)
# STRAVA_CLIENT_ID= / STRAVA_CLIENT_SECRET=
# FITBIT_CLIENT_ID= / FITBIT_CLIENT_SECRET=
# GARMIN_CONSUMER_KEY= / GARMIN_CONSUMER_SECRET=

# Queue + integrations
# Shared secret for the cron-triggered sync queue processor (header: x-cron-secret).
# The edge function accepts either name; set ONE to avoid drift.
# PROCESS_SYNC_QUEUE_SECRET=
# CRON_SYNC_QUEUE_SECRET=
# GARMIN_WEBHOOK_SECRET=
#
# GARMIN_WEBHOOK_SECRET is REQUIRED for the garmin-webhook Edge Function. The
# webhook rejects (503) if the env var is missing. Generate a strong random
# string, configure it in Supabase Dashboard → Edge Functions → Secrets, and
# provide it to Garmin during webhook URL registration.
#
# The webhook authenticates each push by HMAC-SHA256 over the RAW request body,
# keyed with this secret, and expects the lowercase hex digest in:
#   x-garmin-signature: <hex digest>
# Comparison is timing-safe; a missing or mismatched header is a 401.
# See supabase/functions/garmin-webhook/index.ts.
#
# NOTE: this scheme is not yet confirmed against Garmin's live specification —
# the Connect Developer Program integration call is the point at which to verify
# the header name and digest encoding Garmin actually sends, and to correct both
# this file and the handler if they differ.

# Token encryption at rest (oauth_tokens) — generate a 32-byte key, base64-encode
# OAUTH_TOKEN_ENCRYPTION_KEY=

# Supabase type generation: npx supabase login && npm run gen:types

# --- Symphony orchestration (local only, optional) ---
# Used by OpenAI Symphony's Linear tracker client. This is not a VITE_ variable
# and must never be exposed to the browser bundle.
LINEAR_API_KEY=
