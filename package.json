{
  "name": "phoenix-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "assert:no-sourcemaps": "node scripts/assert-no-sourcemaps.mjs dist",
    "assert:supabase-config": "node scripts/assert-live-supabase-config.mjs",
    "auth:social:check": "node scripts/sync-social-auth.mjs check",
    "auth:social:push": "node scripts/sync-social-auth.mjs push",
    "auth:apple:rotate": "node scripts/generate-apple-client-secret.mjs --write-env",
    "build": "vite build",
    "dev": "vite",
    "lint": "biome check .",
    "audit:security": "npm audit --audit-level=moderate",
    "test": "node scripts/run-without-node-webstorage.mjs vitest run",
    "test:watch": "node scripts/run-without-node-webstorage.mjs vitest",
    "test:sync": "cross-env MOCK_EDGE_FUNCTIONS=true node scripts/run-without-node-webstorage.mjs vitest run tests/sync/",
    "test:sync:live": "cross-env MOCK_EDGE_FUNCTIONS=false SYNC_LIVE_TESTS=true node scripts/run-without-node-webstorage.mjs vitest run tests/sync/",
    "check:edge-functions": "node scripts/check-edge-functions.mjs",
    "optimize:logo": "node scripts/optimize-logo.mjs",
    "analyze": "cross-env ANALYZE=true vite build",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:e2e:ui": "node scripts/run-playwright-e2e.mjs --ui",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run assert:no-sourcemaps && npm run assert:supabase-config",
    "verify:full": "npm run verify && npm run test:e2e",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.3.0",
