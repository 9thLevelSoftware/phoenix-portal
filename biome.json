{
	"$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"*.json",
			"*.ts",
			"*.mjs",
			"src/**/*.ts",
			"src/**/*.tsx",
			"tests/**/*.ts",
			"tests/**/*.tsx",
			"e2e/**/*.ts",
			"e2e/**/*.tsx",
			"scripts/**/*.mjs",
			"supabase/functions/**/*.ts",
			"!package-lock.json",
			"!tsconfig.tsbuildinfo",
			"!src/lib/database.types.ts",
			"!docs/archive",
			"!docs/superpowers",
			"!dist",
			"!node_modules",
			"!playwright-report",
			"!test-results"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 80
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noArrayIndexKey": "warn",
				"noExplicitAny": "warn",
				"useIterableCallbackReturn": "warn",
				"noDocumentCookie": "warn"
			},
			"a11y": {
				"useButtonType": "warn",
				"noSvgWithoutTitle": "warn",
				"useSemanticElements": "warn",
				"noLabelWithoutControl": "warn",
				"noStaticElementInteractions": "warn",
				"useFocusableInteractive": "warn",
				"useAriaPropsForRole": "warn",
				"noRedundantAlt": "warn"
			},
			"correctness": {
				"noUnusedFunctionParameters": "warn",
				"noUnusedVariables": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn"
			},
			"security": {
				"noDangerouslySetInnerHtml": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
